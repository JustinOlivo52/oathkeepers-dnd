# Copy this file to .env and fill it in. Never commit .env.

# Claude API key for the AI Dungeon Master (console.anthropic.com -> API keys).
# Leave empty to play with the free demo DM.
ANTHROPIC_API_KEY=

# Monthly cap on AI spending, in US dollars. The server stops calling the AI when it's reached.
DM_MONTHLY_BUDGET_USD=20

# Port for the game server.
PORT=8787

# Hosting only. New players need this code to make an account, and the AI DM is only for signed-in
# players, so strangers who find the site can't spend your budget. Share it with friends privately.
GROUP_CODE=

# Postgres for saves (hosting). Leave unset to save JSON files in packages/server/data.
# DATABASE_URL=postgres://user:pass@host:5432/oathkeepers
